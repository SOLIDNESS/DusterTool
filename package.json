{
  "name": "duster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "keys": "tsx scripts/gen-keys.ts",
    "balances": "tsx scripts/balances.ts",
    "scan": "tsx scripts/scan.ts",
    "simulate": "tsx scripts/simulate-convert.ts",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "build:program": "bash scripts/build-program.sh",
    "test:program": "cargo test -p duster",
    "localnet": "bash scripts/localnet.sh",
    "e2e": "tsx scripts/localnet/e2e.ts",
    "localnet:pump": "bash scripts/localnet-pump.sh",
    "rehearsal:prepare": "tsx scripts/localnet/pump-prepare.ts",
    "rehearsal": "tsx scripts/localnet/pump-rehearsal.ts",
    "duster": "tsx scripts/live/duster.ts",
    "crank": "tsx src/bot/crank.ts",
    "deploy:program": "bash scripts/live/deploy-program.sh",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server=server/index.ts crank=src/bot/crank.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --legal-comments=none",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "pack": "bash deploy/pack.sh",
    "push": "bash deploy/push.sh",
    "remote": "bash deploy/remote.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
