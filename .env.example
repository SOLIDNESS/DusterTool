# Skopiuj do .env i uzupelnij. Plik .env nie trafia do repozytorium.

# Endpoint RPC mainnetu. Publiczny dziala do odczytow, ale ma niskie limity:
# do wdrozenia programu i do aplikacji potrzebny jest platny (Helius, Triton, QuickNode...).
RPC_URL=https://api.mainnet-beta.solana.com

# Nazwa wdrozenia = plik z deployments/ (test = token testowy na mainnecie, local = lokalny walidator).
DEPLOYMENT=test

# Oplata priorytetowa w mikrolamportach za jednostke obliczen (skrypty, bot, aplikacja).
PRIORITY_MICROLAMPORTS=20000
